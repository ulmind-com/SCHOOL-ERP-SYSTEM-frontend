# ──────────────────────────────────────────────────────────────
#  Scholarly ERP — web environment
#  Copy to .env.local. Never commit the real one.
# ──────────────────────────────────────────────────────────────

# Where the API lives. Locally that is the uvicorn dev server; in production it
# is the API service's URL, e.g. https://scholarly-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8010

NEXT_PUBLIC_APP_NAME=Scholarly

# saas      -> the sign-in page offers the platform console and asks which
#              institution when an email belongs to more than one.
# dedicated -> neither is shown; there is only one institution.
NEXT_PUBLIC_DEPLOYMENT_MODE=saas

# Used to build resize URLs for photographs, e.g.
# https://ik.imagekit.io/<your id>
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
